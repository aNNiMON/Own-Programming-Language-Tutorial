use std

include "own/Registry.own"
include "own/Config.own"
include "own/Packages.own"
include "own/Projects.own"
include "own/Own.own"

DEBUG=getenv("OWN_DEBUG", "false") == "true"
logger = {}
logger.color = def(num = 0) = sprintf("%s[0%sm", toChar(27), num > 0 ? (";" + num) : "")
logger.error = def(a = "", b = "", c = "") = echo(logger.color(31) + a, b, c + logger.color())
logger.success = def(a = "", b = "", c = "") = echo(logger.color(32) + a, b, c + logger.color())
logger.info = def(a = "", b = "", c = "") = echo(a, b, c)
logger.debug = match(DEBUG) {
  case true: logger.info
  case _: def(a = "", b = "", c = "") = 0
}

ctx = {}
ctx.DEBUG = DEBUG
ctx.TMPDIR = getenv("TEMP", getenv("TMP", "."))
ctx.OSNAME = getprop("os.name", "win").toLowerCase()
ctx.logger = logger
ctx.registry = new Registry(ctx)
ctx.config = new Config(ctx)
ctx.packages = new Packages(ctx)
ctx.projects = new Projects(ctx)
ctx.own = new Own(ctx)

match ARGS {
  case (): ctx.own.usage()
  case ("init"): ctx.own.init()
  case ("install"): ctx.own.install()
  case ("run"): ctx.own.runScript("default")
  case [cmd :: _] if cmd == "add": ctx.own.addDependencies()
  case [cmd :: _] if cmd == "usage": ctx.own.showUsages()
  case [cmd :: script] if cmd == "run": ctx.own.runScript(script)
  case _: ctx.own.usage()
}
